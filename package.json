{
  "name": "umbraco-engage-editor-mcp",
  "version": "1.0.0-alpha.2",
  "type": "module",
  "description": "MCP server for Umbraco Engage — A/B testing, personalization, personas, segments, campaigns, and analytics tools for AI agents.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./collections": "./dist/collections.js",
    "./tool-types": {
      "types": "./dist/tool-types.d.ts"
    }
  },
  "bin": {
    "umbraco-engage-editor-mcp": "./dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup --config tsup.config.ts",
    "postbuild": "umbraco-mcp-generate-types --registry-name EngageTools",
    "compile": "tsc --noEmit",
    "watch": "tsup --config tsup.config.ts --watch",
    "generate": "orval --config orval.config.ts",
    "umbraco:bootstrap": "bash scripts/bootstrap-demo-site.sh",
    "umbraco:start": "bash scripts/bootstrap-demo-site.sh && dotnet run --project demo-site",
    "start:umbraco": "npm run umbraco:start",
    "umbraco:stop": "lsof -ti :44448 | xargs kill 2>/dev/null; lsof -ti :44449 | xargs kill 2>/dev/null; true",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=__tests__ --runInBand",
    "test:one": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:rerun-failures": "grep '^FAIL ' test-failures.log 2>/dev/null | sed 's/^FAIL //' | tr '\\n' ' ' | xargs -r node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit || echo 'No failures to rerun (test-failures.log not found or empty)'",
    "test:changed": "node scripts/test-changed.mjs",
    "test:evals": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/evals/jest.config.ts --runInBand --forceExit",
    "test:all": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=__tests__ --runInBand --forceExit && node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/evals/jest.config.ts --runInBand --forceExit",
    "test:e2e": "npx playwright test --config tests/hosted-e2e/playwright.config.ts",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Umbraco",
    "MCP",
    "Model Context Protocol"
  ],
  "author": "Umbraco",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.191",
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@umbraco-cms/mcp-hosted": "1.0.0-beta.38",
    "@umbraco-cms/mcp-server-sdk": "1.0.0-beta.38",
    "agents": "^0.6.0",
    "dotenv": "^17.4.2",
    "uuid": "^11.1.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@jest/types": "^29.6.3",
    "@playwright/test": "^1.61.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/uuid": "^10.0.0",
    "@types/yargs": "^17.0.33",
    "jest": "^30.4.2",
    "msw": "^2.14.6",
    "orval": "^8.28.1",
    "patch-package": "^8.0.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "undici": "^7.0.0",
    "wrangler": "^4.104.0"
  }
}
